{
  "name": "boardui-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:registry": "node --test tests/registry.test.mjs",
    "test": "npm run test:registry && npm run test:icons && npm run test:evidence && npm run test:tokens && npm run test:grid && npm run test:doc-factories && npm run test:chart-stacking",
    "build:pages": "node scripts/build-pages.mjs",
    "test:export": "node scripts/check-export.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "test:release": "node scripts/release-gate.mjs",
    "icons:generate": "node scripts/generate-icon-registry.mjs",
    "test:icons": "node scripts/generate-icon-registry.mjs --check",
    "build:library": "node scripts/build-library.mjs",
    "test:library": "npm run build:library && node scripts/check-library.mjs",
    "test:consumer": "node scripts/test-consumer-example.mjs",
    "test:consumer:browser": "node scripts/check-consumer-browser.mjs",
    "docs:api": "node scripts/generate-api-reference.mjs",
    "test:api": "node scripts/generate-api-reference.mjs --check",
    "test:evidence": "node scripts/check-evidence.mjs && node --test tests/evidence-gate.test.mjs",
    "test:tokens": "node scripts/check-semantic-tokens.mjs",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "predev": "npm run fonts:prepare",
    "prebuild": "npm run fonts:prepare",
    "prebuild:pages": "npm run fonts:prepare",
    "test:grid": "node --test tests/grid-sort.test.mjs",
    "test:doc-factories": "node --test tests/doc-factories.test.mjs",
    "test:chart-stacking": "node --test tests/chart-stacking.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@internationalized/date": "3.12.4",
    "@remixicon/react": "4.9.0",
    "clsx": "^2.1.1",
    "motion": "12.42.2",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-aria-components": "^1.8.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "subset-font": "2.9.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "sharp": "0.35.5"
  }
}
